<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>{% block title %}Home page{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="{% block description %}Tuya{% endblock %}" name="description" />
    <meta content="{% block author %}Tuya{% endblock %}" name="author" />

    <!-- App favicon -->
{#    <link rel="shortcut icon" href="{{ asset('build/images/favicon.ico') }}">#}

    <!-- Daterangepicker css -->
    <!--<link rel="stylesheet" href="assets/vendor/daterangepicker/daterangepicker.css"> -->

    <!-- Vector Map css -->
    <!--<link rel="stylesheet" href="assets/vendor/admin-resources/jquery.vectormap/jquery-jvectormap-1.2.2.css"> -->

    <!-- Theme Config Js -->
    <script src="{{ asset('build/hyper/js/hyper-config.js') }}"></script>

    <!-- App css -->
    <link href="{{ asset('build/hyper/css/app-creative.min.css') }}" rel="stylesheet" type="text/css" id="app-style" />

    <!-- Icons css -->
    <link href="{{ asset('build/hyper/css/icons.min.css') }}" rel="stylesheet" type="text/css" />

    {# Datatable Boostrap #}
    <link href="{{ asset('build/hyper/vendor/datatables.net-bs5/css/dataTables.bootstrap5.min.css') }}" rel="stylesheet" type="text/css" />
    <link href="{{ asset('build/hyper/vendor/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css') }}" rel="stylesheet" type="text/css" />

    {# JStree #}
    <link href="{{ asset('build/hyper/vendor/jstree/themes/default/style.min.css') }}" rel="stylesheet" type="text/css">


    {% block javascripts %}

    {% endblock %}

    <!-- App css -->
    {% block stylesheets %}
        {{ encore_entry_link_tags('styles') }}
    {% endblock %}
</head>
<body>
{% block body %}
    <!-- Begin page -->
    <div class="wrapper">


        <!-- ========== Topbar Start ========== -->
        <div class="navbar-custom">
            <div class="topbar container-fluid">
                <div class="d-flex align-items-center gap-lg-2 gap-1">

                    <!-- Topbar Brand Logo -->
                    <div class="logo-topbar">
                        <!-- Logo light -->
                        <a href="{{ path('app_home') }}" class="logo-light">
                                <span class="logo-lg">
                                    {# <img src="{{ asset('build/images/logo.png') }}" alt="logo"> #}
                                </span>
                            <span class="logo-sm">
                                    {# <img src="{{ asset('build/images/logo-sm.png') }}" alt="small logo"> #}
                                </span>
                        </a>

                        <!-- Logo Dark -->
                        <a href="{{ path('app_home') }}" class="logo-dark">
                                <span class="logo-lg">
                                    {# <img src="{{ asset('build/images/logo-dark.png') }}" alt="dark logo"> #}
                                </span>
                            <span class="logo-sm">
                                    {# <img src="{{ asset('build/images/logo-dark-sm.png') }}" alt="small logo"> #}
                                </span>
                        </a>
                    </div>

                    <!-- Sidebar Menu Toggle Button -->
                    <button class="button-toggle-menu">
                        <i class="mdi mdi-menu"></i>
                    </button>

                    <!-- Horizontal Menu Toggle Button -->
                    <button class="navbar-toggle" data-bs-toggle="collapse" data-bs-target="#topnav-menu-content">
                        <div class="lines">
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                    </button>

                    <!-- Topbar Search Form -->
                    <div class="app-search dropdown d-none d-lg-block">
                        <div class="dropdown-menu dropdown-menu-animated dropdown-lg" id="search-dropdown">
                            <!-- item-->
                            <div class="dropdown-header noti-title">
                                <h5 class="text-overflow mb-2">Found <span class="text-danger">17</span> results</h5>
                            </div>

                            <!-- item-->
                            <a href="javascript:void(0);" class="dropdown-item notify-item">
                                <i class="uil-notes font-16 me-1"></i>
                                <span>Analytics Report</span>
                            </a>

                            <!-- item-->
                            <a href="javascript:void(0);" class="dropdown-item notify-item">
                                <i class="uil-life-ring font-16 me-1"></i>
                                <span>How can I help you?</span>
                            </a>

                            <!-- item-->
                            <a href="javascript:void(0);" class="dropdown-item notify-item">
                                <i class="uil-cog font-16 me-1"></i>
                                <span>User profile settings</span>
                            </a>

                            <!-- item-->
                            <div class="dropdown-header noti-title">
                                <h6 class="text-overflow mb-2 text-uppercase">Users</h6>
                            </div>

                            <div class="notification-list">
                                <!-- item-->
                                <a href="javascript:void(0);" class="dropdown-item notify-item">
                                    <div class="d-flex">
                                        {# <img class="d-flex me-2 rounded-circle" src="{{ asset('build/images/users/avatar-2.jpg') }}" alt="Generic placeholder image" height="32"> #}
                                        <div class="w-100">
                                            <h5 class="m-0 font-14">Erwin Brown</h5>
                                            <span class="font-12 mb-0">UI Designer</span>
                                        </div>
                                    </div>
                                </a>

                                <!-- item-->
                                <a href="javascript:void(0);" class="dropdown-item notify-item">
                                    <div class="d-flex">
                                        {# <img class="d-flex me-2 rounded-circle" src="{{ asset('build/images/users/avatar-5.jpg') }}" alt="Generic placeholder image" height="32"> #}
                                        <div class="w-100">
                                            <h5 class="m-0 font-14">Jacob Deo</h5>
                                            <span class="font-12 mb-0">Developer</span>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <ul class="topbar-menu d-flex align-items-center gap-3">
                    <li class="dropdown">
                        <a {% if is_granted('ROLE_ADMIN', app.user) %}style="background-color:#DFEFF9!important;"{% endif %} class="nav-link dropdown-toggle arrow-none nav-user px-2" data-bs-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false">
                                <span class="account-user-avatar">
                                     {% if is_granted('ROLE_ADMIN', app.user) %}
                                         <i class="mdi mdi-24px mdi-shield-account"></i>
                                    {% else %}
                                         <i class="mdi mdi-24px mdi-account"></i>
                                     {% endif %}
                                    {# <img src="{{ asset('build/images/users/avatar-1.jpg') }}" alt="user-image" width="32" class="rounded-circle"> #}
                                </span>
                            <span class="d-lg-flex flex-column gap-1 d-none">
                                    <h5 class="my-0">{{ app.user.username }}</h5>
                                    {% if is_granted('ROLE_ADMIN', app.user) %}
                                        <h6 class="my-0 fw-normal">{{'home.user.admin'|trans}}</h6>
                                    {% endif %}
                                </span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-animated profile-dropdown">
                            <!-- item-->
                            <a href="{{path('app_user_show_user', {'id': app.user.id})}}" class="dropdown-item">
                                <i class="mdi mdi-card-account-details-outline me-1"></i>
                                <span>{{ 'home.user.my_account' | trans }}</span>
                            </a>

                            <!-- item-->
                            <a href="{{ path('app_logout') }}" class="dropdown-item">
                                <i class="mdi mdi-logout me-1"></i>
                                <span>{{ 'home.user.logout' | trans }}</span>
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
        <!-- ========== Topbar End ========== -->

        <!-- ========== Left Sidebar Start ========== -->
        <div class="leftside-menu">

            <!-- Brand Logo Light -->
            <a href="{{ path('app_home') }}" class="logo logo-light">
                    <span class="logo-lg">
                        <img src="{{ asset('build/images/') }}" alt="logo">
                    </span>
                <span class="logo-sm">
                        <img src="{{ asset('build/images/favicon.ico') }}" alt="small logo">
                    </span>
            </a>

            <!-- Brand Logo Dark -->
            <a href="{{ path('app_home') }}" class="logo logo-dark">
                    <span class="logo-lg">
                        <img src="{{ asset('build/images/') }}" alt="dark logo">
                    </span>
                <span class="logo-sm">
                        <img src="{{ asset('build/images/favicon.ico') }}" alt="small logo">
                    </span>
            </a>

            <!-- Sidebar Hover Menu Toggle Button -->
            <div class="button-sm-hover" data-bs-toggle="tooltip" data-bs-placement="right" title="Show Full Sidebar">
                <i class="ri-checkbox-blank-circle-line align-middle"></i>
            </div>

            <!-- Full Sidebar Menu Close Button -->
            <div class="button-close-fullsidebar">
                <i class="ri-close-fill align-middle"></i>
            </div>

            <!-- Sidebar -left -->
            <div class="h-100" id="leftside-menu-container" data-simplebar>
                <!-- Leftbar User -->
                <div class="leftbar-user">
                    <a href="pages-profile.html">
                        {# <img src="{{ asset('build/images/users/avatar-1.jpg') }}" alt="user-image" height="42" class="rounded-circle shadow-sm"> #}
                        <span class="leftbar-user-name mt-2">{# user.username #}</span>
                    </a>
